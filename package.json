{
    "name": "your-project",
    "version": "1.0.0",
    "description": "Project frontend assets",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "concurrently --names \"PHP,GULP\" --prefix-colors \"blue.bold,green.bold\" \"npm:php\" \"gulp watch\"",
        "dev:vite": "concurrently --names \"PHP,VITE\" --prefix-colors \"blue.bold,yellow.bold\" \"npm:php\" \"vite\"",
        "php": "php -S localhost:8000 -t public",
        "build": "gulp build",
        "build:prod": "cross-env NODE_ENV=production gulp build",
        "build:vite": "vite build",
        "build:vite:prod": "cross-env NODE_ENV=production vite build",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:ui": "vitest --ui",
        "test:cover": "vitest run --coverage",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:all": "vitest run && playwright test",
        "lint:js": "eslint resources/js/**/*.js",
        "lint:css": "stylelint resources/scss/**/*.scss",
        "lint:fix": "eslint resources/js/**/*.js --fix",
        "format": "prettier --write resources/"
    },
    "devDependencies": {
        "@playwright/test": "^1.48.0",
        "@vitest/coverage-v8": "^2.1.0",
        "@vitest/ui": "^2.1.0",
        "autoprefixer": "^10.4.20",
        "browser-sync": "^3.0.3",
        "concurrently": "^9.1.0",
        "cross-env": "^7.0.3",
        "cssnano": "^7.0.6",
        "del": "^7.1.0",
        "eslint": "^9.13.0",
        "gulp": "^5.0.0",
        "gulp-avif": "^1.1.0",
        "gulp-cache": "^1.1.3",
        "gulp-concat": "^2.6.0",
        "gulp-dart-sass": "^1.1.0",
        "gulp-imagemin": "^9.1.0",
        "gulp-postcss": "^10.0.0",
        "gulp-rename": "^2.0.0",
        "gulp-sourcemaps": "^3.0.0",
        "gulp-terser": "^2.1.0",
        "gulp-webp": "^5.0.0",
        "imagemin-mozjpeg": "^10.0.0",
        "imagemin-optipng": "^8.0.0",
        "imagemin-svgo": "^10.0.0",
        "jsdom": "^25.0.1",
        "postcss": "^8.4.47",
        "prettier": "^3.3.3",
        "sass": "^1.80.0",
        "stylelint": "^16.10.0",
        "stylelint-config-standard-scss": "^13.1.0",
        "vite": "^6.0.0",
        "vitest": "^2.1.0"
    }
}