{
    "name": "miguelex/php-template",
    "description": "PHP 8.2–8.5 MVC template with PHPStan, Rector, Pest, Gulp/Vite and AI agent support",
    "type": "project",
    "keywords": [
        "php",
        "mvc",
        "template",
        "phpstan",
        "rector",
        "pest",
        "gulp",
        "vite"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "monolog/monolog": "^3.7",
        "phpmailer/phpmailer": "^7.1",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "filp/whoops": "^2.15",
        "friendsofphp/php-cs-fixer": "^3.64",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-arch": "^3.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.0",
        "rector/rector": "^2.0",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "phpcs --standard=phpcs.xml src/",
        "lint:fix": "php-cs-fixer fix src/ --config=.php-cs-fixer.php",
        "stan": "phpstan analyse --configuration=phpstan.neon",
        "rector": "rector process --dry-run",
        "rector:fix": "rector process",
        "test": "./vendor/bin/phpunit --configuration=phpunit.xml",
        "test:pest": "./vendor/bin/pest",
        "test:cover": "./vendor/bin/phpunit --configuration=phpunit.xml --coverage-html storage/coverage",
        "qa": [
            "@lint",
            "@stan",
            "@test"
        ],
        "post-install-cmd": [
            "php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ]
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true,
        "platform": {
            "php": "8.2"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
